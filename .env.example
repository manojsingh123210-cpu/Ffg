# ── Telegram ─────────────────────────────────────────────
BOT_TOKEN=123456789:AA...your_new_bot_token
BOT_USERNAME=YourNewBot
WEBHOOK_URL=https://your-service.onrender.com
WEBHOOK_SECRET=change_me_to_a_long_random_string

# ── Numeric Telegram admin IDs, comma separated ──────────
# Get yours from @userinfobot
ADMIN_IDS=111111111,222222222

# ── Website admin login ──────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
WEB_ADMIN_USERNAME=xyvenadmin
WEB_ADMIN_PASSWORD=change_me_strong_password

# ── Storage ──────────────────────────────────────────────
# On Render with a persistent disk mounted at /data:
DB_PATH=/data/xyven.db

# ── Premium custom emojis ────────────────────────────────
# JSON object mapping the 25 slot names to your numeric emoji IDs.
# Example:
# PREMIUM_EMOJI_IDS={"sparkle":"5368324170671202286","crown":"..."}
PREMIUM_EMOJI_IDS={}
